NODE_ENV=development
PORT=3000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://chunky:chunky@localhost:5432/chunky

# AdminJS is available at http://localhost:3000/admin
ADMIN_ENABLED=false
ADMIN_EMAIL=admin@chunky.local
ADMIN_PASSWORD=change-this-password
ADMIN_COOKIE_SECRET=change-this-cookie-secret-before-running-admin

# mock | openai | anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Frontend (copy to apps/web/.env.local when API is hosted elsewhere)
VITE_API_URL=http://localhost:3000
